# Leave VITE_API_BASE_URL unset in the browser so Vite (dev) or Caddy (prod)
# can route /api/auth and /api/familyos. Production SSR uses API_BASE_URL
# at container runtime (see new_deployment/family_os/docker-compose.yml).
# VITE_API_BASE_URL=

# Production CI build-args. Dev defaults stay localhost.
VITE_SSO_URL=http://localhost:5173
VITE_APP_URL=http://localhost:1577
